# Experimental iPadOS 17 root attempt for polaris (SDM845).
# NativeUfs includes the optional read-only block backend in this profile.
# Host, inherited SMMU/DMA mapping, and root publication still require
# hardware qualification; compiling this profile does not enable runtime I/O.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_POLARIS_HID_INPUT=y
CONFIG_XNU_NATIVE_ADRENO=n
# Kernel console needs build/native-legacy-display/libNativeLegacyDisplay.late.a
# (baseline scripts/build-native-legacy-display.py); polaris has its own
# libPolarisDisplayRuntime.a instead, so this stays off until ported.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_ARMVIRT_PLATFORM=n

